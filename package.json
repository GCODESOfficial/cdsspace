{
  "name": "cds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:content-style && npm run check:browser-modals && npm run check:upload-security && npm run check:email-logo && npm run check:client-navigation && npm run check:auth-browser && npm run check:static-assets && npm run check:dashboard-auth && npm run check:subscription",
    "build": "next build",
    "build:next": "npm run check:content-style && next build",
    "check:content-style": "node scripts/check-content-style.mjs",
    "check:browser-modals": "node --test tests/client-drive-storage.test.mjs",
    "check:upload-security": "node --test tests/upload-security.test.mjs",
    "check:email-logo": "node scripts/check-email-logo.mjs",
    "check:client-navigation": "node scripts/check-client-navigation.mjs",
    "check:auth-browser": "node scripts/check-auth-browser-compatibility.mjs",
    "check:dashboard-auth": "node --test tests/dashboard-session-core.test.mjs tests/staff-portal-identity.test.mjs && node scripts/check-dashboard-auth-contract.mjs",
    "check:subscription": "node scripts/check-subscription-checkout-contract.mjs",
    "check:static-assets": "node scripts/check-static-assets.mjs",
    "test:cmeet": "node --test tests/cmeet-auto-translate.test.mjs tests/cmeet-captions.test.mjs tests/cmeet-popup-layout.test.mjs tests/cmeet-speech-gate.test.mjs tests/cmeet-translation-isolation.test.mjs tests/cmeet-approval-agenda.test.mjs tests/cmeet-call-controls.test.mjs tests/cmeet-incoming-ringer.test.mjs",
    "test:cmeet:browser": "node scripts/cmeet-browser-smoke.mjs",
    "test:letterhead:preview": "node scripts/letterhead-preview-smoke.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "deploy": "npx -y glashdb deploy --asset-mode inline --source-upload chunked",
    "start": "next start",
    "lint": "eslint .",
    "populate-prospects": "npx --yes esbuild@0.24.0 scripts/populate-prospects.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/populate-prospects.cjs --alias:@=./src --alias:server-only=./scripts/server-only-stub.js --external:pg --log-level=warning && node -r dotenv/config node_modules/.cache/populate-prospects.cjs"
  },
